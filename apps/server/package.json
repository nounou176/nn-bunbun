{
  "name": "@bunbun/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "dependencies": {
    "@bunbun/contracts": "0.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "inspect:storage": "node --import tsx src/inspect-storage.ts",
    "inspect:audio": "node --import tsx src/inspect-audio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @bunbun/contracts",
    "test": "node --import tsx --test --test-isolation=none test/**/*.test.ts"
  }
}
