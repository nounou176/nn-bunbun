{
  "name": "@bunbun/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./dist/schema/index.js"
    },
    "./version": {
      "types": "./src/version.ts",
      "import": "./dist/version.js"
    },
    "./fixtures/basic-catalog": "./fixtures/catalogs/basic-catalog.json",
    "./fixtures/valid-find-dog-loop": "./fixtures/manifests/valid-find-dog-loop.json",
    "./fixtures/valid-complete-primitive-loop": "./fixtures/manifests/valid-complete-primitive-loop.json",
    "./fixtures/valid-m8-cached-speech": "./fixtures/manifests/valid-m8-cached-speech.json",
    "./fixtures/m8-last-train": "./fixtures/manifests/m8-last-train.json",
    "./fixtures/m8-last-train-catalog": "./fixtures/catalogs/m8-last-train-catalog.json",
    "./fixtures/m8-last-train-study-catalog": "./fixtures/references/m8-last-train-study-catalog.json",
    "./fixtures/m8-last-train-approved-profile": "./fixtures/references/m8-last-train-approved-profile.json",
    "./fixtures/bunbun-core-reference": "./fixtures/references/bunbun-core-0.1.0.json",
    "./fixtures/learning-target-registry": "./fixtures/adaptive/learning-target-registry-0.1.0.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "schema:write": "node --import tsx scripts/generate-artifacts.ts",
    "schema:check": "node --import tsx scripts/generate-artifacts.ts --check",
    "test": "node --import tsx --test --test-isolation=none test/**/*.test.ts",
    "inspect:manifest": "node --import tsx scripts/inspect-manifest.ts",
    "inspect:authoring": "node --import tsx scripts/inspect-authoring.ts",
    "inspect:authoring:v2": "node --import tsx scripts/inspect-authoring-v2.ts",
    "inspect:authoring-eval": "node --import tsx scripts/inspect-authoring-evaluation.ts",
    "inspect:authoring-eval:v2": "node --import tsx scripts/inspect-authoring-evaluation-v2.ts",
    "run:authoring-eval": "node --import tsx scripts/run-authoring-evaluation.ts",
    "run:authoring-eval:v2": "node --import tsx scripts/run-authoring-evaluation-v2.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typebox": "^1.3.12"
  }
}
