{
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogId",
    "revision",
    "scenes",
    "assetBundles",
    "locations",
    "entities",
    "objects",
    "presentationCues",
    "voiceProfiles",
    "referenceRecords"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sceneId",
          "variantIds",
          "cameraPresetIds",
          "assetBundleIds",
          "spawnPoints"
        ],
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "variantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "cameraPresetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "assetBundleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "spawnPoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "spawnPointId",
                "kind",
                "reachableFromPlayer",
                "exclusiveOccupancy"
              ],
              "properties": {
                "spawnPointId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "PLAYER",
                    "ENTITY",
                    "OBJECT"
                  ]
                },
                "reachableFromPlayer": {
                  "type": "boolean"
                },
                "exclusiveOccupancy": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assetBundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetBundleId",
          "sceneIds"
        ],
        "properties": {
          "assetBundleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "sceneIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "locations": {
      "type": "array",
