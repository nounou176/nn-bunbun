    "referenceRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "referenceId",
          "targetKinds",
          "providerId",
          "providerVersion"
        ],
        "properties": {
          "referenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "targetKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "VOCABULARY",
                "GRAMMAR",
                "KANJI"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "providerVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunbun.local/schemas/catalog-snapshot-0.1.0.schema.json",
  "title": "Bunbun CatalogSnapshot 0.1.0",
  "additionalProperties": false
}
