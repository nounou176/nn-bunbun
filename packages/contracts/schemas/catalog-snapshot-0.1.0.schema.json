        "properties": {
          "catalogLocationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "sceneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "stateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "catalogEntityId",
          "roles",
          "sceneIds",
          "stateIds"
        ],
        "properties": {
          "catalogEntityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "NPC",
                "ANIMAL"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sceneIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "stateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "catalogObjectId",
          "sceneIds",
          "stateIds",
          "affordances"
        ],
        "properties": {
          "catalogObjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "sceneIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "stateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "affordances": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INTERACTIVE",
                "PICK_UP",
                "GIVE"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "presentationCues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cueId",
          "sceneId"
