        "properties": {
          "cueId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "sceneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "additionalProperties": false
      }
    },
    "voiceProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "voiceProfileId"
        ],
        "properties": {
          "voiceProfileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "additionalProperties": false
      }
